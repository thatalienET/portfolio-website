<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    {% set title = "Alex Smith Designs" %}
    {% set description = "Alex Smith Motion Designer Portfolio Website" %}
    <title>{{ title }}</title>
    <meta name=description content="{{ description }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--- 
        <meta http-equiv="refresh" content="0; url=https://alexsmithdesigns.uk/under-construction" />
    -->
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preload" as="style" href="/style.css">
    <link rel="preload" as="style" href="/pages/shared/carousel.css">
    <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@100;300;400;900&display=swap">
    <link rel="preload" as="script" href="https://unpkg.com/@rive-app/webgl2@2">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Stylesheets -->
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@100;300;400;900&display=swap">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/pages/shared/carousel.css">
    {% block headStylesheets %}
    <!-- Add extra stylesheets here if needed -->
    {% endblock %}
    <!-- Scripts -->
    <script src="https://kit.fontawesome.com/edfb6d0ddc.js" crossorigin="anonymous" async></script>
    <script src="/shared.js" async></script>
    <script src="/pages/shared/carousel.js" async></script>
    <script async src="https://unpkg.com/@rive-app/webgl2@2"></script>
    {% block headScripts %}
    <!-- Add extra scripts here if needed -->
    {% endblock %}
</head>

<body>
    <nav>
        <a href="/" aria-label="face-logo home link" class="logo-wrapper">
            <canvas id="canvas-1" class="logo" aria-label="alex-face"></canvas>
        </a>
        <!-- Navigation links -->
        {% block topnav %}
        <div id="topnav" class="topnav">
            <a href="/" {% if activeNav == 1 %}class="active"{% endif %}>HOME</a>
            <a href="/projects" {% if activeNav == 2 %}class="active"{% endif %}>PROJECTS</a>
            <a href="/interactive" {% if activeNav == 3 %}class="active"{% endif %}>INTERACTIVE</a>
            <a href="/info" {% if activeNav == 4 %}class="active"{% endif %}>INFO</a>
        </div>
        {% endblock %}
        <div class="links">
            <a class="links-item" aria-label="instagram" href="https://www.instagram.com/studioalexandraink">
                <i aria-label="instagram" class="fa-brands fa-instagram fa-sm"></i>
            </a>
            <a class="links-item" aria-label="linkedin" href="https://www.linkedin.com/in/alexannesmith/">
                <i aria-label="linkedin" class="fa-brands fa-linkedin-in fa-sm"></i>
            </a>
            <a class="links-item" aria-label="tiktok" href="https://www.tiktok.com/@alex.smith.motiondesign">
                <i aria-label="tiktok" class="fa-brands fa-tiktok fa-sm"></i>
            </a>
        </div>
        <a href="#" rel="nofollow" aria-label="menu-icon" class="menu-icon" onclick="menuControl()">
            <i aria-label="menu-icon" class="fa fa-bars fa-2xs"></i>
        </a>
    </nav>
    <svg viewBox="0 0 600 30" class="banner-drip">
        <path d="M0,10 C100,30 200,0 300,10 C350,15 500,30 600,10  L600,00 L0,00 Z"></path>
    </svg>

    {% block content %}
    <!-- Default content for the layout -->
    <div style="margin: 27vh 0; width: 100%; text-align: center;">Template</div>
    {% endblock %}

    <div class="pre-footer-info">
        <h1 class="font-black">LETS WORK TOGETHER!</h1>
        <h2><a href="mailto:hi@alexsmithdesigns.uk">hi@alexsmithdesigns.uk</a></h2>
    </div>

    <svg viewBox="0 0 600 30" class="banner-drip">
        <path d="M0,20 C100,0 200,30 300,20 C350,15 500,0 600,20  L600,30 L0,30 Z"></path>
    </svg>
    <footer>
        <a class="footer-link" aria-label="instagram" href="https://www.instagram.com/studioalexandraink">
            <i aria-label="instagram" class="fa-brands fa-instagram"></i>
        </a>
        <a class="footer-link" aria-label="linkedin" href="https://www.linkedin.com/in/alexannesmith/">
            <i aria-label="linkedin" class="fa-brands fa-linkedin-in"></i>
        </a>
        <a class="footer-link" aria-label="tiktok" href="https://www.tiktok.com/@alex.smith.motiondesign">
            <i aria-label="tiktok" class="fa-brands fa-tiktok"></i>
        </a>
        <a class="footer-link" aria-label="rive" href="https://rive.app/@alexsmithdesigns.uk">
            <i aria-label="rive" class="fa-solid fa-r"></i>
        </a>
        <a class="footer-link" aria-label="contra" href="https://contra.com/alex_smith_j41lq0xm">
            <i aria-label="contra" class="fa-solid fa-c"></i>
        </a>
    </footer>
    {% block riveRenderer %}
    {% include "./shards/rive-script.njk" %}
    {% endblock %}
</body>

</html>