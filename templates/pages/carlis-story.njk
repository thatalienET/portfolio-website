{% extends "../layout.njk" %}
{% block headStylesheets %}
<link rel="preload" as="style" href="/pages/carlis-story.css">
<link rel="stylesheet" href="/pages/carlis-story.css">
{% endblock %}
{% block content %}
    <div class="project">
        <div class="intro purple-bg">
            <div class="intro-title">
                <img src="/assets/projects/carlis story/Carli_s Story Text.png">
            </div>
            <div class="intro-text">
                <p>This project was a work of pure passion.</p>
                <br />
                <p>
                    I was entusted by the charity Homeless Oxfordshire to tell Carli's real story. Given
                    the tough and personal nature of the story I knew I would be dealing with, I
                    wanted to use a style that captures the reality of life and its imperfections. This
                    intention led me to chose a hand drawn style and to use Carlis actual voice as
                    narration.
                <p>
                </p>
            </div>
        </div>
        <iframe src="https://player.vimeo.com/video/1037236226?badge=0&autopause=0&player_id=0&app_id=58479"
            frameborder="0" allow="fullscreen; picture-in-picture; clipboard-write" class="reel"
            title="Oxford Hommeless - Carli V7.2"></iframe>
        <div class="flex-row purple-bg fullwidth-bottom">
            <div class="flex-title">
                <h1 class="font-light">Moodboards</h1>
            </div>
            <div class="flex-column-a">
                <img src="/assets/projects/carlis story/Storyboard Images/Concept 1.jpg">
                <img src="/assets/projects/carlis story/Storyboard Images/Concept 3.jpg">
            </div>
            <div class="flex-column-b">
                <img src="/assets/projects/carlis story/Storyboard Images/Concept 2.jpg">
            </div>
        </div>
        <div class="flex-row fullwidth-bottom">
            <div class="flex-title">
                <h1 class="font-light" style="color: 272822;">Initial Ideas</h1>
            </div>
            <img style="width: 26%;"
                src="/assets/projects/carlis story/Initial Ideas/GIF_Optimized/Falling - snake wrap around hand_optimized.gif">
            <img style="width: 48%; padding: 0% 1%;"
                src="/assets/projects/carlis story/Initial Ideas/GIF_Optimized/I was naught in school_optimized.gif">
            <img style="width: 26%;"
                src="/assets/projects/carlis story/Initial Ideas/GIF_Optimized/CU - Snake around hand_optimized.gif">
            <img style="width: 25%;" src="/assets/projects/carlis story/Initial Ideas/Initial Idea 3.png">
            <img style="width: 30%; margin: 0% 10%;"
                src="/assets/projects/carlis story/Initial Ideas/Initial Idea 1.png">
            <img style="width: 25%;" src="/assets/projects/carlis story/Initial Ideas/Initial Idea 2.png">
        </div>
        <div class="flex-row purple-bg padding">
            <img style="width: 31%;"
                src="/assets/projects/carlis story/Planning and Animatic/Animatic - Walking Plan.png">
            <img style="width: 37%; padding: 0% 1%;"
                src="/assets/projects/carlis story/Planning and Animatic/GIFS/Knowlage Share - Plate Moving.gif">
            <img style="width: 31%;"
                src="/assets/projects/carlis story/Planning and Animatic/Animatic - dad at table.png">
        </div>
        <div class="flex-row purple-bg padding">
            <img style="width: 100%;"
                src="/assets/projects/carlis story/Planning and Animatic/GIFS/Knowlage Share - Woman at Table.gif">
        </div>
        <div class="flex-row purple-bg padding">
            <img style="width: 61%;"
                src="/assets/projects/carlis story/Planning and Animatic/GIFS/Secondary_Action.gif">
            <img style="width: 36%; padding: 0% 1%;"
                src="/assets/projects/carlis story/Planning and Animatic/Rocking Kid Plan.png">
        </div>
        <div class="flex-row purple-bg padding">
            <img style="width: 100%;" src="/assets/projects/carlis story/Planning and Animatic/Montage Plan.png">
        </div>
        <img class="fullwidth" src="/assets/projects/carlis story/Colour Script.jpg">

        <div class="flex-row fullwidth">
            <div class="flex-column-b">
                <img src="/assets/projects/carlis story/Colouring_Assembly/colouring_dining_scene.gif">
            </div>
            <div class="flex-column-a">
                <img style="margin-bottom: 40px;"
                    src="/assets/projects/carlis story/Colouring_Assembly/Cigarette_optimized.gif">
                <img src="/assets/projects/carlis story/Colouring_Assembly/Lighter_optimized.gif">
            </div>
        </div>
    </div>
{% endblock %}